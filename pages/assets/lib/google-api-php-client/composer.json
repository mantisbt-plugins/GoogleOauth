{
    "name": "googleoauth-plugin/google-api-client",
    "description": "Bundled google/apiclient for the MantisBT GoogleOauth plugin",
    "type": "library",
    "require": {
        "php": ">=7.4",
        "google/apiclient": "^2.15"
    },
    "config": {
        "allow-plugins": {
            "google/apiclient-services": true
        },
        "audit": {
            "ignore": ["PKSA-y2cr-5h3j-g3ys"]
        }
    }
}
